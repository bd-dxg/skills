{
  "settings": {
    "mcpFooterStatus": "off"
  },
  "mcpServers": {
    "chrome-devtools": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--slim",
        "--autoConnect",
        "--no-usage-statistics"
      ]
    },
    "searchcode": {
      "url": "https://api.searchcode.com/v1/mcp"
    },
    "tavily-remote-mcp": {
      "url": "https://mcp.tavily.com/mcp/?tavilyApiKey=<YOUR_TAVILY_API_KEY>",
      "directTools": false
    },
    "reqable": {
      "command": "npx",
      "args": [
        "-y",
        "reqable-mcp-server",
        "--scope",
        "minimal"
      ],
      "env": {
        "NO_PROXY": "192.168.10.2,localhost,127.0.0.1"
      }
    }
  }
}
